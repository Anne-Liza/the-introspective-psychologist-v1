APP_NAME="The Introspective Psychologist Production Proof"
APP_PROFILE_NAME="therapy_practice"
APP_ENV="production"
APP_VERSION="1.0.0"
SEED_DEMO_DATA="false"
APP_RELEASE_CHANNEL="starter"
CLIENT_NAME="The Introspective Psychologist Production Proof"
DEPLOYMENT_TARGET="production"
API_DOCS_ENABLED=false

# Managed PostgreSQL.
# Use the provider connection string from Supabase, Neon, Render, Railway, AWS RDS, or another managed PostgreSQL provider.
# SQLAlchemy/psycopg format:
DATABASE_URL="postgresql+psycopg://the_introspective_psychologist_production_proof:the_introspective_psychologist_production_proof@db:5432/the_introspective_psychologist_production_proof"

# Auth secrets.
# Generate separate long random values for each secret:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY="replace-with-a-long-random-production-secret"
JWT_REFRESH_SECRET_KEY="replace-with-a-different-long-random-production-secret"
INVITATION_TOKEN_SECRET="replace-with-a-third-long-random-production-secret"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Field-level encryption key.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY="replace-with-generated-data-encryption-key"

# Production URLs.
BACKEND_CORS_ORIGINS="https://your-frontend-domain.com"
FRONTEND_BASE_URL="https://your-frontend-domain.com"

# Initial admin.
SUPER_DEVELOPER_EMAIL="admin@yourdomain.com"
SUPER_DEVELOPER_PASSWORD="replace-with-a-strong-temporary-admin-password"
SUPER_DEVELOPER_FULL_NAME="The Introspective Psychologist Production Proof Developer"

# Email.
EMAIL_PROVIDER="smtp"
EMAIL_FROM="noreply@yourdomain.com"
SMTP_HOST="smtp.yourprovider.com"
SMTP_PORT=587
SMTP_USERNAME="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_USE_TLS=true

# File storage.
# Use "local" only if the host has persistent disk configured.
# The S3-compatible storage adapter is scaffolded only. Switch to "s3", "cloudflare_r2", "supabase", or "minio" only after implementing the selected adapter.
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES="image/jpeg,image/png,image/webp,application/pdf,text/plain"

# S3-compatible storage.
S3_ENDPOINT_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_REGION="auto"

# Payments.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""

# Monitoring.
SENTRY_DSN=""

# Rate limits.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_REQUESTS=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=300
RATE_LIMIT_AUTH_IP_REQUESTS=10
RATE_LIMIT_AUTH_IP_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_IDENTIFIER_REQUESTS=5
RATE_LIMIT_AUTH_IDENTIFIER_WINDOW_SECONDS=900
RATE_LIMIT_INVITATION_MANAGE_REQUESTS=30
RATE_LIMIT_INVITATION_MANAGE_WINDOW_SECONDS=3600
RATE_LIMIT_CONTACT_REQUESTS=3
RATE_LIMIT_CONTACT_WINDOW_SECONDS=600
RATE_LIMIT_UPLOAD_REQUESTS=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=3600
